# Build-time input for tools/gen-secret.mjs. The runtime reads
# tgcloud/lib/secret.js (gitignored); Serverless has no environment variables.
# Each key is 32 nonzero bytes of hex (64 characters). Never reuse a key across
# domains and never commit .env.
CONTENT_KEYS_JSON={"2":"<64 hex characters>"}
CURRENT_CONTENT_KEK_VERSION=2
IDENTITY_KEYS_JSON={"1":"<64 hex characters>"}
CURRENT_IDENTITY_KEK_VERSION=1
ACTION_KEYS_JSON={"1":"<64 hex characters>"}
CURRENT_ACTION_KEK_VERSION=1
