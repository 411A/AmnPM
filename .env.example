# ── Build-time keys for tools/gen-secret.mjs ────────────────────────────────
# Telegram Serverless has no runtime environment or secret store. This file is
# read only by the generator; the deployed bot reads tgcloud/lib/secret.js.
# Never commit .env or tgcloud/lib/secret.js. Keep an offline backup of the keys.
#
# VERSION RULES — read before editing
# - A version number maps to one key forever.
# - To rotate: ADD a new version and set CURRENT_* to that new version.
# - Keep every old version. Old rows reference their version and cannot be
#   decrypted without it.
# - Replacing a key under an existing version makes old ciphertext unreadable.
# - Removing a version while old rows still use it makes them unreadable.
# - The generator merges existing versions, never drops them, refuses to replace
#   an existing version's key, and refuses a CURRENT_* that is missing.
# - Leave this file absent to preserve the current keys untouched.
# - There is no automatic re-encryption. Old keys stay valid until a future
#   migration re-wraps/re-encrypts the old rows.
# - If secret.js is missing, restore it from backup. Use --init only for a
#   brand-new deployment with no existing data.
#
# CONTENT_KEYS_JSON: version -> 64 hex characters.
# Wraps each link's per-link data key (tokens, memos, topics, aliases, jobs).
# Each link stores its version in links.kek_version, so old links keep using
# the old content key. Safe rotation: add a version, then set CURRENT_CONTENT_*
# to it; keep the old version.
CONTENT_KEYS_JSON={"3":"<new 64 hex characters>"}
CURRENT_CONTENT_KEK_VERSION=3
#
# IDENTITY_KEYS_JSON: version -> 64 hex characters.
# Wraps the installation salt and new owner/sender chat ids, and derives
# sender/session/block keys. The salt stores its own id:<version>; old identity
# keys must remain. Owner/sender chat ids do NOT store an identity version yet,
# so DO NOT change CURRENT_IDENTITY_KEK_VERSION: rows sealed with the old
# current identity key would become unreadable. Keep the current version; add a
# new version only as an unused placeholder until the fallback/migration lands.
IDENTITY_KEYS_JSON={}
CURRENT_IDENTITY_KEK_VERSION=1
#
# ACTION_KEYS_JSON: version -> 64 hex characters.
# Derives per-link keys for reply/read/block buttons. The database holds only
# part of the action ciphertext; the Telegram button holds the rest. Old action
# tokens try every action version, then fall back to the link data key, so old
# versions must remain until those tokens expire. Safe rotation: add a version
# and set CURRENT_ACTION_* to it.
ACTION_KEYS_JSON={"2":"<new 64 hex characters>"}
CURRENT_ACTION_KEK_VERSION=2
